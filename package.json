{
  "name": "dsh-plugin-bench",
  "version": "0.1.0",
  "description": "dsh plugin: run a command N times, get best/median/p95 + spread and an environment fingerprint. Refuses to call a noisy sample a measurement.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
